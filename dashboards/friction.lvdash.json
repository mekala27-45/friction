{
 "datasets": [
  {
   "name": "totals",
   "displayName": "Decision totals",
   "queryLines": [
    "SELECT COUNT(*) AS decisions,\n",
    "       SUM(CASE WHEN d.verdict = 'decline' THEN 1 ELSE 0 END) AS declines,\n",
    "       SUM(CASE WHEN d.verdict = 'step_up' THEN 1 ELSE 0 END) AS step_ups,\n",
    "       SUM(CASE WHEN l.is_fraud THEN GREATEST(d.amount_cents, 0) ELSE 0 END) / 100.0 AS fraud_usd,\n",
    "       SUM(CASE WHEN l.is_fraud AND d.verdict <> 'approve' THEN GREATEST(d.amount_cents, 0) ELSE 0 END) / 100.0\n",
    "         AS captured_usd,\n",
    "       1000.0 * SUM(CASE WHEN NOT COALESCE(l.is_fraud, false) AND d.verdict <> 'approve' THEN 1 ELSE 0 END)\n",
    "         / SUM(CASE WHEN NOT COALESCE(l.is_fraud, false) THEN 1 ELSE 0 END) AS friction_per_1000_good\n",
    "FROM workspace.friction_dev_gold.payments_decisions d LEFT JOIN (SELECT event_ref, is_fraud FROM workspace.friction_dev_cdc.labels_payments_history WHERE __END_AT IS NULL) l ON l.event_ref = d.txn_ref\n",
    "WHERE d.event_date < DATE'2019-11-01'\n"
   ]
  },
  {
   "name": "daily",
   "displayName": "Decisions by day",
   "queryLines": [
    "SELECT event_date AS day, verdict, COUNT(*) AS decisions\n",
    "FROM workspace.friction_dev_gold.payments_decisions WHERE verdict <> 'approve' GROUP BY ALL\n"
   ]
  },
  {
   "name": "weekly_capture",
   "displayName": "Fraud dollars stopped by week",
   "queryLines": [
    "SELECT DATE_TRUNC('WEEK', d.event_date) AS week,\n",
    "       SUM(CASE WHEN l.is_fraud THEN GREATEST(d.amount_cents, 0) ELSE 0 END) / 100.0 AS fraud_usd,\n",
    "       SUM(CASE WHEN l.is_fraud AND d.verdict <> 'approve' THEN GREATEST(d.amount_cents, 0) ELSE 0 END) / 100.0\n",
    "         AS captured_usd\n",
    "FROM workspace.friction_dev_gold.payments_decisions d LEFT JOIN (SELECT event_ref, is_fraud FROM workspace.friction_dev_cdc.labels_payments_history WHERE __END_AT IS NULL) l ON l.event_ref = d.txn_ref\n",
    "WHERE d.event_date < DATE'2019-11-01' GROUP BY ALL\n"
   ]
  },
  {
   "name": "codes",
   "displayName": "Reason codes on step ups and declines",
   "queryLines": [
    "SELECT c.code, r.says, COUNT(*) AS decisions\n",
    "FROM workspace.friction_dev_gold.payments_decisions d LATERAL VIEW EXPLODE(SPLIT(d.codes, ',')) c AS code\n",
    "JOIN workspace.friction_dev_gold.reason_codes r ON r.code = c.code AND r.desk = 'payments'\n",
    "WHERE d.verdict <> 'approve' AND d.codes <> '' GROUP BY ALL\n"
   ]
  },
  {
   "name": "quarantine",
   "displayName": "Rows refused by rule",
   "queryLines": [
    "SELECT desk, rule, COUNT(*) AS rows_refused FROM workspace.friction_dev_silver.quarantine GROUP BY ALL\n"
   ]
  },
  {
   "name": "ledger",
   "displayName": "Compute by job",
   "queryLines": [
    "SELECT job, task, COUNT(*) AS runs, SUM(compute_seconds) / 60.0 AS compute_minutes,\n",
    "       SUM(CASE WHEN status = 'failed' THEN 1 ELSE 0 END) AS failed_runs\n",
    "FROM workspace.friction_dev_ops.run_ledger GROUP BY ALL\n"
   ]
  },
  {
   "name": "accounts",
   "displayName": "Sign in attempts by account kind",
   "queryLines": [
    "SELECT CASE WHEN unknown_account THEN 'unknown account' ELSE 'known account' END AS account,\n",
    "       SUM(attempts) AS attempts, SUM(successes) AS successes\n",
    "FROM workspace.friction_dev_silver.login_account_stats GROUP BY ALL\n"
   ]
  }
 ],
